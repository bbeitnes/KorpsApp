// ⚠️ VIKTIG: BEGGE databasene i skiensskolemusikk-b5cbc — (default) OG den
// navngitte databasen «test» — DELES med Bestillingsportal (organisasjoner/
// prosjekter/behovslinjer/soknader/tilbud/bestillinger/kjop/rapporter/
// aktivitetslogg m.fl. — se dens eget repo for de reglene). Firestore har
// bare ÉT regelsett pr. database, så `firebase deploy --only
// firestore:rules` med BARE denne filen mot NOEN AV DEM sletter
// Bestillingsportals regler der og gir dem "Missing or insufficient
// permissions" — skjedde på (default) 2026-08-10, og (fordi jeg feilaktig
// trodde «test» var Korpsapp-eksklusiv) på «test» rett etterpå samme dag.
// Begge ble rettet ved å hente opp igjen forrige regelsett (ruleset-
// historikk i Firebase) og flette inn korpsIndex-tillegget derfra.
//
// Skal denne filen ut mot NOEN av databasene i dette prosjektet, må den
// FØRST flettes sammen med Bestillingsportals gjeldende regelsett for akkurat
// den databasen (hent aktivt regelsett via Firebase Rules API eller
// Console — ikke anta at det som ligger her er hele bildet, og ikke anta
// at «test» er unntatt).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function korpsAllowed(korps) {
      return !('accessMode' in korps)
        || korps.accessMode != 'restricted'
        || (('allowedEmails' in korps) && (request.auth.token.email in korps.allowedEmails));
    }

    // Lettvekts-speil av korpslisten (kun id/navn/rekkefølge/lås-status) —
    // se KORPS_INDEX_COLLECTION i index.html for hvorfor denne finnes: uten
    // den avslo Firestore HELE korpslisten for alle andre enn de som sto i
    // allowedEmails, i det øyeblikket ett eneste korps ble låst (accessMode:
    // "restricted"), siden et ufiltrert "list"-kall feiler i sin helhet
    // dersom ETT ENESTE dokument det kunne returnert ville brutt reglene.
    match /korpsIndex/{korpsId} {
      allow read, write: if isSignedIn();
    }

    match /korpsapp/{korpsId} {
      allow read, update, delete: if isSignedIn() && (resource == null || korpsAllowed(resource.data));
      allow create: if isSignedIn();

      match /arrangementer/{arrangementId} {
        allow read, write: if isSignedIn()
          && korpsAllowed(get(/databases/$(database)/documents/korpsapp/$(korpsId)).data);

        match /checkpoints/{checkpointId} {
          allow read, write: if isSignedIn()
            && korpsAllowed(get(/databases/$(database)/documents/korpsapp/$(korpsId)).data);
        }
      }
    }
  }
}
